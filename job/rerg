#!/usr/bin/env bash
# Rewrite the row groups of parquet files in the scan store, in place, where
# the data lives: a GCP Batch task in us-east1 (the bucket's region) runs
# `pqtk re-rg`; the laptop only lists, submits, and polls. Originals are kept
# beside the rewrites as `<name>.bak` unless -i.
#
#   job/rerg 'gs://oa-gcs-usage-dvx/sweep/runs/<run>/would-delete/*.parquet'
#   job/rerg -r 25000 'gs://oa-gcs-usage-dvx/listing/2026-08-01/*/*.parquet'
#
# Options: -r ROWS (rows per group, default 65536), -i (no .bak), -k SUFFIX
# (backup suffix, default .bak), -m MACHINE (default n2-standard-4).
set -euo pipefail
PROJECT=oa-internal-450019
REGION=us-east1
IMAGE=us-central1-docker.pkg.dev/$PROJECT/cloud-run-source-deploy/pqtk:latest
SA=gcs-usage-job@$PROJECT.iam.gserviceaccount.com
STAGING=gs://oa-gcs-usage-dvx/pqtk
PQTK=${PQTK:-$HOME/c/pqtk/.venv/bin/pqtk}
# pqtk shells out to gcloud: pin the account that can reach the bucket, if the active one can't.
[ -z "${RERG_GCLOUD_ACCOUNT:-}" ] || export CLOUDSDK_CORE_ACCOUNT=$RERG_GCLOUD_ACCOUNT

rows=65536 mode=(-k .bak) machine=n2-standard-4
while getopts "r:ik:m:" o; do
  case $o in
    r) rows=$OPTARG ;;
    i) mode=(-i) ;;
    k) mode=(-k "$OPTARG") ;;
    m) machine=$OPTARG ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { sed -n '2,12p' "$0" >&2; exit 2; }

for glob in "$@"; do
  "$PQTK" re-rg "$glob" "${mode[@]}" -r "$rows" --runner gcp-batch \
    --project "$PROJECT" --region "$REGION" --image "$IMAGE" --sa "$SA" --staging "$STAGING" --machine "$machine"
done

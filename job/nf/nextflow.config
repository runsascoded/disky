// The cw scan's Nextflow config (job/nf/cw.nf). The work dir lives in the data bucket so every task sees the bucket
// FUSE-mounted at /mnt/disks/<bucket> (`$GCS/$DATA` in the steps); the cache beside it (`NXF_CLOUDCACHE_PATH`, set by
// the head) is what lets a fresh head resume a failed scan.
params.data_bucket = 'oa-cw-s3-usage-data'
params.image = 'us-central1-docker.pkg.dev/oa-internal-450019/cw-s3-usage/scan:latest'
params.labels = [deployment: 'cw', component: 'scan']
params.session = ''

workDir = "gs://${params.data_bucket}/nf/work"
plugins { id 'nf-google@1.29.1' }

google {
    project = 'oa-internal-450019'
    location = 'us-east1'
    batch.serviceAccountEmail = 'cw-s3-job@oa-internal-450019.iam.gserviceaccount.com'
    batch.bootDiskSize = 50.GB
}

process {
    executor = 'google-batch'
    container = params.image
    // The image's ENTRYPOINT is the one-VM driver (`scan-run supervise -- bash job/$JOB_SCRIPT`); a task runs
    // Nextflow's own `/bin/bash … .command.run`, so `env` just execs it. The VM mounts the whole work-dir bucket at
    // /mnt/disks/<bucket>, but the container gets only the task's own dir: bind the bucket in, so the steps' writes
    // under `$GCS/$DATA` land in it (unbound, they went to the container's filesystem and were lost).
    containerOptions = "--entrypoint=/usr/bin/env -v /mnt/disks/${params.data_bucket}:/mnt/disks/${params.data_bucket}:rw"
    // `nf-session`: the head's sweep finds a killed run's leftover tasks by it (job/nf/cw-head.sh)
    resourceLabels = params.labels + (params.session ? ['nf-session': params.session] : [:])
    maxRetries = 0
    // One failed step lets the running ones finish (and be cached for the resume) rather than killing them.
    errorStrategy = 'finish'
    withLabel: small  { machineType = 'e2-standard-2' }
    withLabel: medium { machineType = 'e2-standard-4' }
    // index-write (DuckDB, 16 GB) and the interval store's append (16 GiB RSS, ~25 GiB disk at a compaction). A
    // typed `disk` is a new disk at /tmp, where the steps stage (`WORK_DIR`); untyped, it only grows the pd boot disk,
    // which slowed the 02a import from 5.5–6.8 to 8.1 min (2026-10-16T1801). One local SSD is 375 GB; e2 takes none.
    withLabel: big    { machineType = 'n2-standard-8'; disk = [request: 375.GB, type: 'local-ssd'] }
    // over-time caps DuckDB at 16 GB (`DUCKDB_MEM`), all of an e2-standard-4
    withLabel: post   { machineType = 'e2-highmem-4' }
}

executor {
    queueSize = 20
    pollInterval = '30 sec'
}

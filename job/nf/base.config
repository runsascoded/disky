// Every deployment's generic process settings for job/nf/scan.nf (specs/pipelines-everywhere.md §2.4). The
// deployment's executor block (work dir, project, region, image, machine per label) is generated from its profile by
// `dt-cloud scan head` and passed after this file (`-c base.config -c executor.config`), so it wins where both set.
params.labels = [:]
params.session = ''
params.cache = true
params.queue_size = 20
params.work_bucket = ''

process {
    // The scan image's ENTRYPOINT is the one-VM driver; a task runs Nextflow's own `/bin/bash … .command.run`, so
    // `env` just execs it (the literal `--entrypoint=""` fails). On google-batch the VM mounts the work dir's bucket
    // at /mnt/disks/<bucket> but the container gets only the task's dir: bind the bucket in, so the steps' writes to
    // the data store land in it (unbound, they went to the container's filesystem and were lost). Ignored with no
    // container (the local executor); awsbatch's generated config replaces it.
    containerOptions = params.work_bucket ? "--entrypoint=/usr/bin/env -v /mnt/disks/${params.work_bucket}:/mnt/disks/${params.work_bucket}:rw" : '--entrypoint=/usr/bin/env'
    // `nf-session`: the head's sweep finds a killed run's leftover tasks by it; `finish -l` prices them
    resourceLabels = params.labels + (params.session ? ['nf-session': params.session] : [:])
    maxRetries = 0
    // One failed step lets the running ones finish (and be cached for the resume) rather than killing them.
    errorStrategy = 'finish'
    // `scan head -F`: every task reruns (each step skips what its own outputs say is done)
    cache = params.cache
}

executor {
    queueSize = params.queue_size
    pollInterval = '30 sec'
}

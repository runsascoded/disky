{
  "name": "gcs",
  "comment": "The gcs deployment's scan-run profile (specs/scan-runs-ui.md): `dt-cloud scan-run -c job/scan-runs.json`. Prices: N2/E2 list $/h, us-central1, compute only; configured reference rates, not billed amounts. N2 vCPU 0.031611 + GB 0.004237; E2 controller from https://cloud.google.com/products/compute/pricing/general-purpose.",
  "project": "oa-internal-450019",
  "regions": ["us-central1", "europe-west4", "us-east1"],
  "jobs": [
    {"kind": "access-ingest", "single_phase": "access-ingest", "nop_marker": "^ingest lease held by ",
     "where": {"image": "gcs-usage-snapshot", "commands": "dt-cloud access ingest|job/access-run\\.sh", "env": ["ACCESS_LOG_BUCKET"], "no_env": ["SCRATCH"]},
     "scan": [{"env": "ACCESS_RUN_ID"}, {"created": "%Y-%m-%dT%H%M"}]},
    {"kind": "compute", "downstream": true, "where": {"entrypoint": "^bash$", "commands": "^job/run.sh$", "env": ["SCAN_COMPUTE_ONLY", "SCAN_ROOT_UID"], "no_env": ["SCRATCH"]},
     "scan": [{"env": "SNAP_ID"}]},
    {"kind": "access", "downstream": true, "where": {"entrypoint": "^bash$", "commands": "^job/run.sh$", "env": ["ACCESS_ONLY", "SCAN_ROOT_UID"], "no_env": ["SCRATCH"]},
     "scan": [{"env": "SNAP_ID"}]},
    {"kind": "reproc", "where": {"entrypoint": "^$", "env": ["REPROC"], "no_env": ["GATE", "SCRATCH", "SNAP_PATH", "SWEEP", "ACCESS_ONLY"]},
     "scan": [{"env": "SNAP_ID"}, {"env": "SNAPSHOT_DATE"}, {"log": "^SNAPSHOT-JOB-DONE (\\S+)"}]},
    {"kind": "scan", "where": {"name": "^(job-|gcs-usage-snapshot)", "image": "gcs-usage-snapshot(:latest|@sha256:)", "entrypoint": "^$",
                              "no_env": ["REPROC", "GATE", "SCRATCH", "SNAP_PATH", "SWEEP", "ACCESS_ONLY", "SWEEP_BENCHMARK_PLAN"]},
     "scan": [{"env": "SNAP_ID"}, {"env": "SNAPSHOT_DATE"}, {"log": "^SNAPSHOT-JOB-(?:DONE|NOP) (\\S+)"}, {"created": "%Y-%m-%d"}]},
    {"kind": "listing", "downstream": true, "where": {"commands": "disk-tree bulk-list \"gcs://"},
     "scan": [{"commands": "/listing/(\\d{4}-\\d{2}-\\d{2}(?:T\\d{4})?)/\\$b"}]}
  ],
  "overlapped": ["access-ingest"],
  "concurrent": ["static-names", "interval-store", "index-sync rows"],
  "nop_marker": "^SNAPSHOT-JOB-NOP ",
  "error_marker": "^\\+\\+ (?:fail_alert|scan_err) (?P<rc>\\d+) (?P<line>\\d+) (?P<cmd>.*)",
  "alerts": {"label": "gcs", "logs_url": "https://console.cloud.google.com/logs/query;query=labels.job_uid%3D%22{job_uid}%22?project={project}"},
  "secrets": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "CLOUDFLARE_API_TOKEN", "DISCORD_BOT_TOKEN", "DISCORD_GCS_USAGE_WEBHOOK", "GCS_USAGE_TOKEN",
              "SLACK_BOT_TOKEN", "SLACK_WEBHOOK", "CF_ACCESS_CLIENT_ID", "CF_ACCESS_CLIENT_SECRET", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"],
  "outputs": [
    {"key": "listing", "uri": "gs://oa-gcs-usage-dvx/listing/{scan}/", "exclude": ["dir-cache/", "index/"], "split": "dir",
     "rows": {"json": "_SUCCESS.json", "field": "objects"}, "after": "listing-fanout", "kinds": ["scan"]},
    {"key": "dir-cache", "uri": "gs://oa-gcs-usage-dvx/listing/{scan}/dir-cache/", "after": "path-index", "kinds": ["scan", "compute"]},
    {"key": "path-index", "uri": "gs://oa-gcs-usage-dvx/listing/{scan}/index/{gen}/", "split": "stem", "rows": "groups", "after": "path-index upload", "kinds": ["scan", "reproc", "compute"]},
    {"key": "snapshot", "uri": "gs://oa-gcs-usage-dvx/snapshots/{scan}/", "after": "publish", "kinds": ["scan", "reproc", "compute"]},
    {"key": "static", "uri": "gs://oa-gcs-usage-dvx/static-names/{static_gen:static-names.json}/manifests/{scan}.json", "manifest": true, "kinds": ["scan"]}
  ],
  "prices": {"n2-highmem-48": 3.1443, "n2-highmem-32": 2.0962, "n2-highmem-16": 1.0481, "n2-highmem-8": 0.5241, "n2-highmem-4": 0.2620, "n2-standard-32": 1.5539, "n2-standard-8": 0.3885, "n2-standard-4": 0.194244, "e2-standard-4": 0.13402284},
  "spot_factor": 0.3,
  "log_days": 30
}

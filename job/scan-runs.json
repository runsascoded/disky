{
  "name": "cw",
  "comment": "The cw-s3 deployment's scan-run profile (specs/scan-runs-ui.md): `dt-cloud scan-run -c job/scan-runs.json`. Prices: n2/e2 list $/h, us-central1, compute only; a Nextflow run is its head plus its step tasks (`finish -l nf-session=…`).",
  "project": "oa-internal-450019",
  "regions": ["us-central1", "us-east1"],
  "run_id_env": ["DT_RUN_ID", "BATCH_JOB_UID"],
  "overlapped": ["static-names"],
  "jobs": [
    {"kind": "scan", "where": {"commands": "^(job/(cw-run|nf/cw-head)\\.sh|scan head )"},
     "scan": [{"env": "SNAP_ID"}, {"log": "^(?:CW-)?SCAN-JOB-DONE (\\S+)"}, {"started": "%Y-%m-%dT%H%M"}]}
  ],
  "error_marker": ["^\\+\\+ scan_err (?P<rc>\\d+) (?P<line>\\d+) (?P<cmd>.*)", "^\\+\\+ on_err (?P<rc>\\d+) (?P<line>\\d+) (?P<cmd>.*)"],
  "alerts": {"label": "CoreWeave scan", "logs_url": "https://console.cloud.google.com/logs/query;query=labels.job_uid%3D%22{job_uid}%22?project={project}"},
  "secrets": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "CLOUDFLARE_API_TOKEN", "SITE_TOKEN", "SLACK_BOT_TOKEN", "R2_ENDPOINT", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "CF_ACCESS_CLIENT_ID", "CF_ACCESS_CLIENT_SECRET"],
  "outputs": [
    {"key": "layer-2", "uri": "gs://oa-cw-s3-usage-data/cw-l2/{scan}/", "exclude": ["index/"], "split": "stem", "after": "layer-2"},
    {"key": "path-index", "uri": "gs://oa-cw-s3-usage-data/cw-l2/{scan}/index/{gen}/", "split": "stem", "rows": "groups", "after": "index-write"},
    {"key": "snapshot", "uri": "gs://oa-cw-s3-usage-data/snapshots/cw/{scan}/", "after": "publish"},
    {"key": "static", "uri": "gs://oa-cw-s3-usage-data/static-names/{static_gen:static-names.json}/manifests/{scan}.json", "manifest": true},
    {"key": "nf-dag", "uri": "gs://oa-cw-s3-usage-data/nf/runs/{scan}/dag.mmd"}
  ],
  "prices": {"n2-standard-8": 0.3885, "n2-standard-16": 0.777, "n2-highmem-16": 1.0481, "e2-standard-2": 0.067, "e2-standard-4": 0.134, "e2-highmem-4": 0.1807},
  "spot_factor": 0.3,
  "log_days": 30
}

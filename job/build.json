{
 "project": "oa-internal-450019",
 "repository": "us-central1-docker.pkg.dev/oa-internal-450019/cloud-run-source-deploy/gcs-usage-snapshot",
 "mirrors": [
  "us-east1-docker.pkg.dev/oa-internal-450019/gcs-usage/scan"
 ],
 "mode": "live",
 "live_tags": [
  "latest"
 ],
 "cache": true,
 "build_args": {
  "SITE": "build",
  "APT_PACKAGES": "time",
  "ENTRYPOINT": "dt-cloud scan-run supervise -- bash job/run.sh"
 },
 "context": [
  "pyproject.toml",
  "README.md",
  "uv.lock",
  "src",
  "cloud/pyproject.toml",
  "cloud/src",
  "job",
  "site",
  "packages",
  "pnpm-workspace.yaml",
  "package.json",
  "pnpm-lock.yaml"
 ],
 "cloudbuild": {
  "machine_type": "E2_HIGHCPU_8",
  "timeout": "1800s"
 },
 "repoint": {
  "region": "us-central1",
  "jobs": [
   "gcs-usage-snapshot-submit"
  ],
  "services": [
   "gcs-alert-relay"
  ]
 }
}

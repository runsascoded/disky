{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules/.vite dist .wrangler",
    "preview": "vite preview",
    "cfn:dev": "wrangler pages dev dist --port 7789",
    "cfn:migrate:local": "wrangler d1 migrations apply disk-tree-auth --local",
    "scrns": "scrns -c scrns.config.json -h 5001 -o ../screenshots",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "scrns:live": "scrns -c scrns.config.json -h r2.rbw.sh --https -o ../screenshots -i treemap"
  },
  "dependencies": {
    "@disk-tree/react": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.6",
    "@open-athena/auth": "github:Open-Athena/auth#43bf9598898d820475b539c985f141e46067b54f",
    "@rdub/file-tree": "github:runsascoded/file-tree#49c02fab96dd4d7b98e695c1bc0c9ac4bb2764a1",
    "@rdub/treemap": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.90.12",
    "fzstd": "0.1.1",
    "hyparquet": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.1",
    "use-kbd": "https://github.com/runsascoded/use-kbd#06ae0cfee696462fb35d761bb413b159eb66a1dd"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sass": "^1.97.2",
    "scrns": "^0.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.129.0"
  }
}

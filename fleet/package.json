{
  "name": "disky-fleet",
  "private": true,
  "version": "0.0.1",
  "description": "A deployment list's docs and fleet page (specs/disky-oa-dev.md): public Markdown docs, a signed-in fleet page over each deployment's health, scan runs and /meta usage, its card as a signed dOGI image, and the Slack post that carries it.",
  "type": "module",
  "devPort": 3870,
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist --port 3871",
    "build": "tsc -p . && tsc -p functions && vite build",
    "typecheck": "tsc -p . && tsc -p functions",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "rm -rf node_modules/.vite dist"
  },
  "dependencies": {
    "@disk-tree/pages-kit": "workspace:*",
    "@open-athena/auth": "github:Open-Athena/auth#baf7314a61f04eb73c4ccc40a5b675a865d0357e",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.150.0"
  }
}

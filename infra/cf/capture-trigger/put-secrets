#!/usr/bin/env python3
"""Mint the capture trigger's AWS key and store it as the Worker's secrets.

  infra/cf/capture-trigger/put-secrets USER   # CLOUDFLARE_API_TOKEN + the AWS account's credentials

USER is the AWS stack's `capture_trigger_user` output
(`pulumi -C infra/aws stack output capture_trigger_user`): `BatchIngest`'s IAM
user, allowed only `batch:SubmitJob` on the ingest queue + job definition.
Creates an access key for it and pipes it into
`wrangler secret put AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY` on stdin —
the secret is never printed, written to disk, or kept in Pulumi state. Any
older keys of the user are deleted after the new one is stored (a rotation).
"""
import subprocess
import sys
from pathlib import Path

import boto3
from click import argument, command

HERE = Path(__file__).resolve().parent
err = lambda *a: print(*a, file=sys.stderr, flush=True)


def put(name: str, value: str) -> None:
    subprocess.run(['pnpm', 'exec', 'wrangler', 'secret', 'put', name], cwd=HERE, input=value, text=True, check=True, stdout=subprocess.DEVNULL)


@command()
@argument('user')
def main(user: str) -> None:
    iam = boto3.Session(region_name='us-east-1').client('iam')
    old = [k['AccessKeyId'] for k in iam.list_access_keys(UserName=user)['AccessKeyMetadata']]
    if len(old) >= 2:
        sys.exit(f'{user} already has 2 keys ({", ".join(old)}); delete one first')
    key = iam.create_access_key(UserName=user)['AccessKey']
    put('AWS_ACCESS_KEY_ID', key['AccessKeyId'])
    put('AWS_SECRET_ACCESS_KEY', key['SecretAccessKey'])
    err(f'stored key {key["AccessKeyId"]} as the Worker secrets')
    for k in old:
        iam.delete_access_key(UserName=user, AccessKeyId=k)
        err(f'deleted old key {k}')


if __name__ == '__main__':
    main()

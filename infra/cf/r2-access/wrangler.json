{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disky-rac-r2-access",
  "account_id": "0dcad5654e9744de6616f74b8df4af63",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {"port": 3277},
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "limits": {"cpu_ms": 10000},
  "r2_buckets": [
    {"binding": "ARCHIVE", "bucket_name": "disky-r2-access-logs"},
    {"binding": "PUBLIC", "bucket_name": "disk-tree-demo"}
  ],
  "secrets": {"required": ["CF_OBSERVABILITY_TOKEN"]},
  "vars": {
    "ACCOUNT_ID": "0dcad5654e9744de6616f74b8df4af63",
    "ARCHIVE_BUCKET_NAME": "disky-r2-access-logs",
    "SOURCE_BUCKETS": "[\"jc-taxes\"]",
    "PUBLIC_BUCKETS": "[\"jc-taxes\"]",
    "PUBLIC_PREFIX": "access/r2",
    "HOURLY_CRON": "13 * * * *",
    "LAG_HOURS": "1",
    "OVERLAP_HOURS": "2",
    "LOOKBACK_HOURS": "6",
    "RETENTION_HOURS": "144",
    "PAGE_SIZE": "500",
    "MAX_PAGES": "50",
    "MAX_HOURS": "48",
    "VERIFY_HOURS": "6",
    "MAX_PAGE_BYTES": "4194304"
  },
  "triggers": {"crons": []}
}

// Generated by `dt-cloud scan head` from the cw-s3 profile: not edited by hand.
workDir = 'gs://example-data/nf/work'
plugins {
    id 'nf-google@1.29.1'
    id 'nf-cloudcache@0.6.2'
}
google {
    project = 'example-project'
    location = 'us-central1'
    batch.serviceAccountEmail = 'scan-job@example-project.iam.gserviceaccount.com'
    batch.bootDiskSize = 50.GB
}
process {
    executor = 'google-batch'
    container = 'us-central1-docker.pkg.dev/example-project/scans/scan:cw'
    withLabel: big { machineType = 'n2-standard-8'; disk = 200.GB }
    withLabel: medium { machineType = 'e2-standard-4' }
    withLabel: post { machineType = 'e2-highmem-4' }
    withLabel: small { machineType = 'e2-standard-2' }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "disky",
  "version": "0.1.0",
  "identifier": "com.runsascoded.disk-tree",
  "build": {
    "frontendDist": "../../../ui/dist",
    "beforeBuildCommand": "cargo build --release -p dt-walker"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "disk-tree-selfsigned"
    },
    "resources": {
      "../target/release/dt-walker": "dt-walker"
    }
  },
  "mainBinaryName": "disky"
}

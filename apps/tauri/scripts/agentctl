#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click"]
# ///
"""Run the laptop's LaunchAgents under `disk-tree.app`'s TCC identity.

`disk-tree-app agent -- CMD…` spawns CMD as a child of the signed app binary,
so one Full Disk Access grant to the app covers every agent, whatever Python
or venv it runs (spec `tauri-native-app.md`, "Scheduled scans").

    agentctl install          # copy the built bundle to ~/Applications, verify its signature
    agentctl check            # launchd probe: does the app (and its children) have FDA?
    agentctl route LABEL…     # prefix LABEL's ProgramArguments with the app wrapper, reload
    agentctl unroute LABEL…   # undo `route`
    agentctl status           # each disk-tree agent: routed or not, last exit
    agentctl adopt            # hand-written agents → disky.json + the app's bundled (SMAppService) agents
    agentctl unadopt          # undo `adopt`
"""
import json
import os
import plistlib
import shutil
import subprocess
import sys
import time
from functools import partial
from pathlib import Path

from click import argument, group, option

err = partial(print, file=sys.stderr)

TAURI = Path(__file__).resolve().parent.parent
BUILT = TAURI / 'target' / 'release' / 'bundle' / 'macos' / 'disky.app'
APP = Path.home() / 'Applications' / 'disky.app'
EXE = APP / 'Contents' / 'MacOS' / 'disky'
AGENTS = Path.home() / 'Library' / 'LaunchAgents'
LOGS = Path.home() / 'Library' / 'Logs' / 'disk-tree'
PREFIX = 'com.runsascoded.disk-tree.'
DOMAIN = f'gui/{os.getuid()}'
SCAN_LABEL = 'com.runsascoded.disky.scan'
CONFIG = Path(os.environ.get('DISK_TREE_ROOT') or Path.home() / '.config' / 'disk-tree') / 'disky.json'
#: legacy hand-written label suffix → the bundled agent's job name
ADOPT = {'index': 'scan', 'drain': 'drain'}


def run(*cmd: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=check, text=True, capture_output=True)


def plist_path(label: str) -> Path:
    return AGENTS / f'{label if label.startswith(PREFIX) else PREFIX + label}.plist'


def wrapper() -> list[str]:
    return [str(EXE), 'agent', '--']


def is_routed(args: list[str]) -> bool:
    """Routed through *an* app wrapper — this one or a previous install
    (e.g. `disk-tree.app` before the rename); `route` replaces a stale one."""
    return len(args) >= 3 and '/Contents/MacOS/' in args[0] and args[1:3] == ['agent', '--']


def last_exit(label: str) -> str | None:
    r = run('launchctl', 'print', f'{DOMAIN}/{label}', check=False)
    if r.returncode:
        return None
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith('last exit code = '):
            return line.removeprefix('last exit code = ')
    return None


def loaded(label: str) -> bool:
    return run('launchctl', 'print', f'{DOMAIN}/{label}', check=False).returncode == 0


def reload(path: Path, label: str, timeout: float = 60) -> None:
    """bootout, wait until the label is gone (a KeepAlive job takes a few
    seconds to tear down; bootstrapping before that fails with exit 5), bootstrap."""
    run('launchctl', 'bootout', f'{DOMAIN}/{label}', check=False)
    deadline = time.monotonic() + timeout
    while loaded(label):
        if time.monotonic() > deadline:
            raise SystemExit(f'{label}: still loaded {timeout:.0f}s after bootout')
        time.sleep(0.25)
    run('launchctl', 'bootstrap', DOMAIN, str(path))


@group()
def cli():
    pass


@cli.command()
@option('-f', '--force', is_flag=True, help='Install even while a scan is running (re-registering the agents kills it)')
def install(force: bool):
    """Copy the built bundle to ~/Applications (a stable path for the FDA grant)."""
    if not BUILT.exists():
        raise SystemExit(f'no bundle at {BUILT}; build it with `cargo tauri build --bundles app`')
    if not force and 'state = running' in run('launchctl', 'print', f'{DOMAIN}/{SCAN_LABEL}', check=False).stdout:
        raise SystemExit('a scan is running (re-registering the agents would kill it); wait for it, or -f')
    run('codesign', '--verify', '--deep', '--strict', str(BUILT))
    # Re-register around the swap so the installed plists are re-rendered from
    # the new bundle's templates (plain LaunchAgents; see services.rs for why
    # not SMAppService, whose agents a rebuilt self-signed binary can't launch).
    registered = [name for name in ('scan', 'drain') if (AGENTS / f'com.runsascoded.disky.{name}.plist').exists()]
    if EXE.exists():
        for name in registered:
            err(disky('agents', 'unregister', name))
    if APP.exists():
        shutil.rmtree(APP)
    run('ditto', str(BUILT), str(APP))
    for name in registered:
        err(disky('agents', 'register', name))
    dr = run('codesign', '-d', '-r-', str(APP)).stdout.strip().splitlines()[-1]
    err(f'installed {APP}')
    err(f'  {dr}')


PROBES = {
    f'{PREFIX}probe': lambda: [str(EXE), 'probe'],
    f'{PREFIX}probe-child': lambda: [*wrapper(), '/bin/ls', '-A', str(Path.home() / 'Library' / 'Mail')],
}


@cli.command()
@option('-t', '--timeout', type=float, default=90, help='Seconds to wait for both probe jobs')
def check(timeout: float):
    """Run the probe as launchd jobs (so TCC sees the app, not this terminal).

    Two jobs: `probe` reads protected dirs in the app's own process; `probe-child`
    has the app spawn `/bin/ls` on one, the shape every routed agent takes.
    Exit 0 only if both succeed.
    """
    LOGS.mkdir(parents=True, exist_ok=True)
    tmp = Path('tmp')
    tmp.mkdir(exist_ok=True)
    for label, args in PROBES.items():
        log = LOGS / f'{label}.log'
        log.write_text('')
        path = tmp / f'{label}.plist'
        with open(path, 'wb') as f:
            plistlib.dump({
                'Label': label, 'ProgramArguments': args(), 'RunAtLoad': True,
                'StandardOutPath': str(log), 'StandardErrorPath': str(log),
            }, f)
        reload(path, label)
    deadline = time.monotonic() + timeout
    codes: dict[str, str | None] = {}
    while time.monotonic() < deadline:
        codes = {label: last_exit(label) for label in PROBES}
        if all(c and c[0].isdigit() for c in codes.values()):
            break
        time.sleep(0.5)
    ok = True
    for label, code in codes.items():
        run('launchctl', 'bootout', f'{DOMAIN}/{label}', check=False)
        print(f'== {label.removeprefix(PREFIX)}: exit {code}')
        print((LOGS / f'{label}.log').read_text().rstrip())
        ok &= code == '0'
    print('FDA: granted' if ok else f'FDA: NOT granted to {APP} (System Settings → Privacy & Security → Full Disk Access → +)')
    sys.exit(0 if ok else 3)


def rewrite(labels: tuple[str, ...], routed: bool) -> None:
    for label in labels:
        path = plist_path(label)
        with open(path, 'rb') as f:
            pl = plistlib.load(f)
        args = pl['ProgramArguments']
        inner = args[3:] if is_routed(args) else args
        new = [*wrapper(), *inner] if routed else inner
        if new == args:
            err(f'{pl["Label"]}: already {"routed" if routed else "unrouted"}')
            continue
        pl['ProgramArguments'] = new
        backup = path.with_suffix(f'.plist.bak-{time.strftime("%Y%m%dT%H%M%S")}')
        shutil.copy2(path, backup)
        with open(path, 'wb') as f:
            plistlib.dump(pl, f)
        reload(path, pl['Label'])
        err(f'{pl["Label"]}: {"routed through" if routed else "unrouted from"} {APP.name} (backup {backup.name})')


@cli.command()
@argument('labels', nargs=-1, required=True)
def route(labels: tuple[str, ...]):
    """Prefix each agent's ProgramArguments with `disk-tree-app agent --` and reload it.

    LABEL may omit the `com.runsascoded.disk-tree.` prefix (`index`, `drain`).
    Re-routes an agent wrapped by a previous install (e.g. `disk-tree.app`) to
    this one. Run `agentctl check` first: a routed agent without the app's FDA
    grant silently scans less. Reloading stops a running job (a scan in flight
    is killed), so pick a quiet moment.
    """
    if not EXE.exists():
        raise SystemExit(f'{EXE} missing; run `agentctl install`')
    rewrite(labels, routed=True)


@cli.command()
@argument('labels', nargs=-1, required=True)
def unroute(labels: tuple[str, ...]):
    """Undo `route`: drop the app wrapper from each agent's ProgramArguments."""
    rewrite(labels, routed=False)


@cli.command()
def status():
    """Each hand-written `com.runsascoded.disk-tree.*` agent (routed or direct,
    last exit), then the app's bundled agents and login item."""
    for path in sorted(AGENTS.glob(f'{PREFIX}*.plist')):
        with open(path, 'rb') as f:
            pl = plistlib.load(f)
        args = pl['ProgramArguments']
        mode = 'app' if is_routed(args) else 'direct'
        cmd = ' '.join(args[3:] if mode == 'app' else args)
        print(f'{pl["Label"].removeprefix(PREFIX):<14} {mode:<7} exit={last_exit(pl["Label"])}  {cmd}')
    if EXE.exists():
        for line in disky('agents', 'status').splitlines() + disky('login-item', 'status').splitlines():
            label = line.split('.plist:')[0] if '.plist:' in line else None
            extra = f'  exit={last_exit(label)}' if label else ''
            print(f'disky: {line}{extra}')


def disky(*args: str) -> str:
    return run(str(EXE), *args, check=False).stdout.strip()


@cli.command()
@option('-f', '--force', is_flag=True, help='Adopt even while the scan agent is running (its scan is killed)')
def adopt(force: bool):
    """Move the hand-written agents into the app: write their commands, env and
    log names to `disky.json`, retire their plists (bootout + rename to
    `*.plist.adopted-<stamp>`), and register the bundled agents
    (`com.runsascoded.disky.{scan,drain}`, shown as "disky" in Login Items).
    """
    if not EXE.exists():
        raise SystemExit(f'{EXE} missing; run `agentctl install`')
    legacy = {s: plist_path(s) for s in ADOPT if plist_path(s).exists()}
    if not legacy:
        raise SystemExit(f'no hand-written agents under {AGENTS}')
    if not force and 'index' in legacy:
        r = run('launchctl', 'print', f'{DOMAIN}/{PREFIX}index', check=False)
        if 'state = running' in r.stdout:
            raise SystemExit('the scan agent is running; wait for it (or -f to kill it)')
    cfg = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    jobs = cfg.setdefault('jobs', {})
    for suffix, path in legacy.items():
        with open(path, 'rb') as f:
            pl = plistlib.load(f)
        args = pl['ProgramArguments']
        job = {'command': args[3:] if is_routed(args) else args}
        if pl.get('EnvironmentVariables'):
            job['env'] = pl['EnvironmentVariables']
        if out := pl.get('StandardOutPath'):
            job['log'] = Path(out).name.split('.')[0]
        jobs[ADOPT[suffix]] = job
    if CONFIG.exists():
        shutil.copy2(CONFIG, CONFIG.with_suffix(f'.json.bak-{time.strftime("%Y%m%dT%H%M%S")}'))
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2) + '\n')
    err(f'wrote {CONFIG}: jobs {sorted(jobs)}')
    stamp = time.strftime('%Y%m%dT%H%M%S')
    for suffix, path in legacy.items():
        label = f'{PREFIX}{suffix}'
        run('launchctl', 'bootout', f'{DOMAIN}/{label}', check=False)
        deadline = time.monotonic() + 60
        while loaded(label):
            if time.monotonic() > deadline:
                raise SystemExit(f'{label}: still loaded 60s after bootout')
            time.sleep(0.25)
        path.rename(path.with_suffix(f'.plist.adopted-{stamp}'))
        err(f'{label}: unloaded, plist retired')
    print(disky('agents', 'register'))


@cli.command()
def unadopt():
    """Undo `adopt`: unregister the bundled agents, restore the newest retired
    hand-written plists, and load them. `disky.json` is left as is."""
    print(disky('agents', 'unregister'))
    for suffix in ADOPT:
        retired = sorted(AGENTS.glob(f'{PREFIX}{suffix}.plist.adopted-*'))
        if not retired:
            continue
        path = plist_path(suffix)
        retired[-1].rename(path)
        reload(path, f'{PREFIX}{suffix}')
        err(f'{PREFIX}{suffix}: restored and loaded')


if __name__ == '__main__':
    cli()

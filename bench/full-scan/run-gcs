#!/usr/bin/env bash
# gcs's real store on the bench VM: plan, bench (1 and all threads, cold + warm ×5), oracle. `fetch-gen` first.
#   run-gcs GEN_DIR LABEL [WORK]
set -euo pipefail
cd "$(dirname "$0")"
gen=$1 label=$2 work=${3:-$HOME/work}
d=$work/$label
mkdir -p "$d"
log() { echo "[$(date +%T)] $label: $*" >&2; }
cargo build -q --release
log bench; /usr/bin/time -f "%e s, %M KB" ./target/release/fsb bench "$gen" "$d/queries.jsonl" -t "1,$(nproc)" -r 5 -l "$label" \
  -o "$d/results.jsonl" -a "$d/answers.jsonl" 2> "$d/bench.log"
tail -1 "$d/bench.log" >&2
log oracle; python oracle/oracle.py -m 100GB -t "$(nproc)" -T "$d/duck" -c "$d/oracle.duckdb" "$gen" "$d/queries.jsonl" "$d/answers.jsonl" \
  > "$d/oracle.json" 2> "$d/oracle.log" || true
cat "$d/oracle.json" >&2

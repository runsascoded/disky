#!/usr/bin/env python3
"""Submit one capture to the `disk-tree-m3` Batch queue (infra/aws/__main__.py).

  aws/submit r2://disk-tree/captures/<host>/<root slug>/<stamp>

Prints the job id; `-w` also follows the job's CloudWatch log until it ends
(exit status = the job's). `-c`/`-m` size this one job past the job def's (a
Fargate vCPU/memory pair, e.g. `-c 4 -m 16384` for a static name index build),
`-e KEY=VALUE` adds to its env (e.g. `STATIC_MEM=12GB`; `DT_TRIGGER=manual` unless given). The account is `.envrc`'s `AWS_PROFILE` (`r`, RAC).
"""
import sys
import time
from datetime import datetime, timezone

import boto3
from click import argument, command, option

QUEUE = 'disk-tree-m3'
JOB_DEF = 'disk-tree-m3-ingest'
LOG_GROUP = '/disk-tree-m3-ingest/batch'
err = lambda *a: print(*a, file=sys.stderr, flush=True)


def follow(batch, logs, job_id: str) -> int:
    stream, token, last_status = None, None, None
    while True:
        job = batch.describe_jobs(jobs=[job_id])['jobs'][0]
        status = job['status']
        if status != last_status:
            err(f'[{job_id[:8]}] {status}')
            last_status = status
        stream = stream or job.get('container', {}).get('logStreamName')
        if stream:
            kw = {'logGroupName': LOG_GROUP, 'logStreamName': stream, 'startFromHead': True}
            if token:
                kw['nextToken'] = token
            try:
                r = logs.get_log_events(**kw)
                for e in r['events']:
                    print(e['message'], flush=True)
                token = r['nextForwardToken']
            except logs.exceptions.ResourceNotFoundException:
                pass
        if status in ('SUCCEEDED', 'FAILED'):
            if status == 'FAILED':
                err(f'[{job_id[:8]}] {job.get("statusReason", "")}')
            return 0 if status == 'SUCCEEDED' else 1
        time.sleep(15)


@command()
@option('-c', '--vcpus', help="vCPUs for this job (a Fargate value: 0.25 … 16), overriding the job def's")
@option('-e', '--env', 'envs', multiple=True, help='KEY=VALUE added to the job env; repeat')
@option('-m', '--memory', type=int, help="Memory MiB for this job (valid for -c on Fargate), overriding the job def's")
@option('-w', '--watch', is_flag=True, help='Follow the job log until it finishes')
@argument('capture')
def main(vcpus: str | None, envs: tuple[str, ...], memory: int | None, watch: bool, capture: str):
    session = boto3.Session(region_name='us-east-1')
    batch = session.client('batch')
    name = f'ingest-{datetime.now(timezone.utc):%Y%m%d-%H%M%S}'
    overrides: dict = {'command': [capture]}
    resources = [{'type': t, 'value': str(v)} for t, v in (('VCPU', vcpus), ('MEMORY', memory)) if v is not None]
    if resources:
        overrides['resourceRequirements'] = resources
    pairs = [e.split('=', 1) for e in envs]
    if any(len(p) != 2 for p in pairs):
        raise SystemExit(f'-e takes KEY=VALUE: {envs}')
    # A hand submit is a `manual` run (`/scans`' trigger) unless `-e DT_TRIGGER=…` says otherwise.
    env = {'DT_TRIGGER': 'manual', **dict(pairs)}
    overrides['environment'] = [{'name': k, 'value': v} for k, v in env.items()]
    job_id = batch.submit_job(
        jobName=name,
        jobQueue=QUEUE,
        jobDefinition=JOB_DEF,
        containerOverrides=overrides,
    )['jobId']
    print(job_id, flush=True)
    if watch:
        sys.exit(follow(batch, session.client('logs'), job_id))


if __name__ == '__main__':
    main()

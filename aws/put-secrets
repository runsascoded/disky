#!/usr/bin/env python3
"""Fill the `disk-tree-m3` stack's Secrets Manager secrets from the worktree's `.envrc`.

Pulumi (`Pulumi.rac.yaml` `secrets`) creates them empty, so values never enter
Pulumi state; this sets them without printing anything secret:
  - `disk-tree-m3/r2-{access-key-id,secret-access-key}` ← `R2_M3_BATCH_*`
    (an R2 account token scoped to Object Read & Write on the `disk-tree` bucket)
  - `disk-tree-m3/cf-d1-token` ← `CF_M3_BATCH_D1_TOKEN` ("disky m3 batch d1": D1 Edit only)
  - `disk-tree-m3/pushover-{token,user}` ← `PUSHOVER_TOKEN` / `PUSHOVER_USER` (the scan-run wrapper's alerts)
Idempotent: a secret whose current value already matches is left alone.
"""
import os
import re
import sys

import boto3
from click import command, option

HERE = os.path.dirname(os.path.abspath(__file__))
ENVRC = os.path.join(HERE, os.pardir, '.envrc')
err = lambda *a: print(*a, file=sys.stderr)


def load_envrc(path: str) -> dict[str, str]:
    vars = {}
    pat = re.compile(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$')
    with open(path) as f:
        for line in f:
            m = pat.match(line)
            if m:
                k, v = m.group(1), m.group(2).strip()
                if v and v[0] in "\"'" and v[-1:] == v[0]:
                    v = v[1:-1]
                vars[k] = v
    return vars


@command()
@option('-p', '--profile', default='r', help='AWS profile of the target (RAC) account')
@option('-v', '--var-prefix', default='R2_M3_BATCH', help='`.envrc` var prefix: `<prefix>_ACCESS_KEY_ID` / `<prefix>_SECRET_ACCESS_KEY`')
def main(profile: str, var_prefix: str):
    envrc = load_envrc(ENVRC)
    values = {
        'disk-tree-m3/r2-access-key-id': envrc.get(f'{var_prefix}_ACCESS_KEY_ID'),
        'disk-tree-m3/r2-secret-access-key': envrc.get(f'{var_prefix}_SECRET_ACCESS_KEY'),
        'disk-tree-m3/cf-d1-token': envrc.get('CF_M3_BATCH_D1_TOKEN'),
        'disk-tree-m3/pushover-token': envrc.get('PUSHOVER_TOKEN'),
        'disk-tree-m3/pushover-user': envrc.get('PUSHOVER_USER'),
    }
    sm = boto3.Session(profile_name=profile, region_name='us-east-1').client('secretsmanager')
    for name, value in values.items():
        if not value:
            raise ValueError(f'{name}: no value in {ENVRC}')
        try:
            current = sm.get_secret_value(SecretId=name)['SecretString']
        except sm.exceptions.ResourceNotFoundException:
            sm.describe_secret(SecretId=name)  # raises if the secret itself is missing
            current = None  # exists (Pulumi-created), no value yet
        if current == value:
            err(f'{name}: up to date')
            continue
        sm.put_secret_value(SecretId=name, SecretString=value)
        err(f'{name}: set')


if __name__ == '__main__':
    main()

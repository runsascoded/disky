#!/usr/bin/env bash
# with-secrets [-f FILE]... [VAR=SECRET]... -- CMD [ARG]...
#
# Run CMD with each VAR set to the latest version of Secret Manager secret SECRET, read as the caller's credentials (on
# the VM pilot's box, its account: infra/gcp/shared). A value goes only into CMD's environment: never argv, a file or
# output. FILE holds `VAR=SECRET` lines (names only; `#` comments). The project is `$DISKY_SECRETS_PROJECT`, else the
# VM's (the metadata server's), so the same script works from a laptop with the variable set.
set -euo pipefail
{ set +x; } 2>/dev/null

usage() { echo "usage: with-secrets [-f FILE]... [VAR=SECRET]... -- CMD [ARG]..." >&2; exit 2; }
pairs=()
while [ $# -gt 0 ]; do
  case "$1" in
    -f)
      [ $# -ge 2 ] || usage
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) ;; *) pairs+=("$line") ;; esac
      done < "$2"
      shift 2 ;;
    --) shift; break ;;
    *=*) pairs+=("$1"); shift ;;
    *) usage ;;
  esac
done
[ $# -gt 0 ] || usage
project=${DISKY_SECRETS_PROJECT:-$(curl -fsS -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/project/project-id)}
for p in ${pairs[@]+"${pairs[@]}"}; do
  var=${p%%=*}
  name=${p#*=}
  if ! [[ $var =~ ^[A-Z_][A-Z0-9_]*$ ]] || [ -z "$name" ]; then
    echo "with-secrets: bad pair ${var}=…" >&2
    exit 2
  fi
  if ! value=$(gcloud secrets versions access latest --secret="$name" --project="$project" --quiet 2>/dev/null); then
    echo "with-secrets: $name (for $var) unreadable in $project" >&2
    exit 1
  fi
  export "$var=$value"
done
unset value
exec "$@"

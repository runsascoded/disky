#!/usr/bin/env bash
# The VM pilot's pack sync (`disky-pack-sync.timer`): each tenant's current pack mirrored from its store
# (`dt-cloud vm-pack pull`, with the tenant's store credentials from Secret Manager, read as its job account), then vmd's config rewritten to
# list every tenant whose pack is on disk. vmd re-reads both on its own (specs/vm-mode.md §5, "Hot swap"): a pack renamed
# over `current.fsb` is mapped anew, a tenant added to the config loads. A tenant whose pull fails keeps its last pack.
set -uo pipefail
{ set +x; } 2>/dev/null

TENANTS=${TENANTS:-/etc/disky/tenants.json}
PACKS=${PACKS:-/var/lib/disky/packs}
CONF=${CONF:-/etc/disky/vmd.json}
LIB=$(dirname "$(readlink -f "$0")")

rc=0
have=()
n=$(jq length "$TENANTS")
for ((i = 0; i < n; i++)); do
  t=$(jq -r ".[$i].name" "$TENANTS")
  store=$(jq -r ".[$i].store" "$TENANTS")
  account=$(jq -r ".[$i].job_account" "$TENANTS")
  mapfile -t env < <(jq -r ".[$i].pack_env // {} | to_entries[] | \"\(.key)=\(.value)\"" "$TENANTS")
  mapfile -t sec < <(jq -r ".[$i].pack_secrets // {} | to_entries[] | \"\(.key)=\(.value)\"" "$TENANTS")
  # The store's credentials read as the tenant's job account (impersonated): the box holds none of a tenant's secrets.
  if out=$(env ${env[@]+"${env[@]}"} "$LIB/with-secrets" -i "$account" ${sec[@]+"${sec[@]}"} -- dt-cloud vm-pack pull -o "$store" -d "$PACKS/$t"); then
    echo "pack-sync: $t: $(jq -c '{state, key, bytes, scans}' <<< "$out")"
  else
    echo "pack-sync: $t: pull from $store failed" >&2
    rc=1
  fi
  [ -s "$PACKS/$t/current.fsb" ] && have+=("$t")
done

# vmd's config: the tenants with a pack, each keyed by `VMD_KEY_<NAME>` (vmd.service's environment, `vmd.secrets`).
names=$(printf '%s\n' ${have[@]+"${have[@]}"} | jq -R . | jq -sc 'map(select(length > 0))')
tmp=$(mktemp "$CONF.XXXXXX")
jq --arg packs "$PACKS" --argjson have "$names" '{
  listen: "127.0.0.1:7340",
  tenants: [.[] | select(.name as $n | $have | index($n)) | {
    name,
    pack: "\($packs)/\(.name)/current.fsb",
    key_env: ("VMD_KEY_" + (.name | ascii_upcase | gsub("-"; "_")))
  }]
}' "$TENANTS" > "$tmp"
chmod 0644 "$tmp"
if cmp -s "$tmp" "$CONF"; then
  rm -f "$tmp"
else
  mv -f "$tmp" "$CONF"
  echo "pack-sync: vmd.json now serves: ${have[*]:-(none)}"
fi
exit $rc

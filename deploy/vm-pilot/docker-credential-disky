#!/bin/sh
# Docker's credential helper for the tenants' Artifact Registry hosts on the VM pilot's box (`credHelpers` in root's
# Docker config, bootstrap.sh): a pull authenticates as the local job's own account, with the short-lived token the
# local job backend minted for it, which reaches `docker run` (and so this helper) only in the environment
# (`$GOOGLE_OAUTH_ACCESS_TOKEN`). The box's own account can't pull a tenant's image.
case "$1" in
  get)
    cat >/dev/null
    if [ -z "${GOOGLE_OAUTH_ACCESS_TOKEN:-}" ]; then
      echo "credentials not found in native keychain"
      exit 1
    fi
    printf '{"Username":"oauth2accesstoken","Secret":"%s"}\n' "$GOOGLE_OAUTH_ACCESS_TOKEN" ;;
  list) echo '{}' ;;
  *) cat >/dev/null ;;  # store / erase: nothing is kept
esac

#!/usr/bin/env bash
# Release a commit to a deployment's prod site: once its dev host serves the commit (its dev release succeeded), push it
# to `<deployment>-prod`, find the "Site release" run `oa-prod-push.yml` dispatches for it, watch it, and check the prod
# host serves it (specs/branch-push-releases.md). Hosts come from `deploy/oa/sites.json`.
#
#   scripts/prod-push DEPLOYMENT SHA
#   scripts/prod-push -r o -w 15 hf SHA    # the push remote (default `o`), minutes to wait for dev (default 15)
#
# Logs go to `tmp/ship/<sha12>/prod-push.log`. The last line printed is `PROD-OK <run id>` on success; anything else
# failed, and the exit status is nonzero. Every step is gated on the one before it (`|| exit 1`), never on `set -e`.
set -uo pipefail

remote=o
wait_min=15
while getopts r:w: o; do
  case $o in
    r) remote=$OPTARG ;;
    w) wait_min=$OPTARG ;;
    *) echo "usage: $0 [-r REMOTE] [-w MIN] DEPLOYMENT SHA" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# = 2 ] || { echo "usage: $0 [-r REMOTE] [-w MIN] DEPLOYMENT SHA" >&2; exit 2; }
d=$1
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here" || exit 2
S=$(git rev-parse --verify "$2^{commit}") || exit 2
sites=deploy/oa/sites.json
repo=$(jq -r .repository $sites)
dev=$(jq -r --arg d "$d" '.sites[$d].dev_host // empty' $sites)
prod=$(jq -r --arg d "$d" '.sites[$d].prod_host // empty' $sites)
[ -n "$dev" ] && [ -n "$prod" ] || { echo "$d: no dev_host/prod_host in $sites" >&2; exit 2; }
export GH_REPO=$repo
logs=tmp/ship/${S:0:12}
mkdir -p "$logs"
log=$logs/prod-push.log
say() { echo "$(date -u +%H:%M:%SZ) $*" | tee -a "$log"; }

# The build a host serves: `x-disky-build: <sha> <time>` (site/functions/_lib/build.ts)
build() { curl -sI "https://$1/" | tr -d '\r' | awk 'tolower($1) == "x-disky-build:" { print $2 }'; }

# 1. Dev serves it: its dev release (CI → "Site release") succeeded
served=
for _ in $(seq 1 $((wait_min * 3))); do
  served=$(build "$dev")
  [ "$served" = "$S" ] && break
  sleep 20
done
[ "$served" = "$S" ] || { say "DEV-NOT-SERVING ($dev serves ${served:-nothing})"; exit 1; }
say "DEV-OK $dev"

# 2. The push, then the release run it dispatches (named `<d> prod · <sha>`)
t=$(date -u +%Y-%m-%dT%H:%M:%SZ)
git push "$remote" "$S:refs/heads/$d-prod" >> "$log" 2>&1 || { say PUSH-FAIL; tail -5 "$log"; exit 1; }
say "PUSHED $d-prod"
run=
for _ in $(seq 1 30); do
  run=$(gh run list -w oa-release.yml -e workflow_dispatch -L 10 --json databaseId,displayTitle,createdAt \
    --jq ".[] | select(.createdAt >= \"$t\" and .displayTitle == \"$d prod · $S\") | .databaseId" | head -1)
  [ -n "$run" ] && break
  sleep 10
done
[ -n "$run" ] || { say NO-RELEASE-RUN; exit 1; }
say "release run $run"
ghws "$run" >> "$log" 2>&1 || { say "PROD-RELEASE-FAIL $run"; tail -20 "$log"; exit 1; }

# 3. Prod serves it
served=$(build "$prod")
[ "$served" = "$S" ] || { say "PROD-NOT-SERVING ($prod serves ${served:-nothing})"; exit 1; }
say "PROD-OK $run"

#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["click"]
# ///
"""Port a D1 migration into another lineage, recording the pair in `twins.json`.

Each directory under `site/migrations/` is one D1 lineage (its own numbering,
applied by `wrangler d1 migrations apply` per database). A migration shared by
several lineages is copied verbatim into each under that lineage's next number,
and the copies are listed together in `site/migrations/twins.json`; the site
test `functions/_lib/testD1.test.ts` asserts every listed group's SQL is identical
(modulo comments and whitespace) on whatever lineages a branch carries.

    scripts/port-migration cw/0021_foo.sql other   # → other/<next>_foo.sql
"""
import json
import re
import sys
from functools import partial
from pathlib import Path

from click import argument, command, option

err = partial(print, file=sys.stderr)

MIGRATIONS = Path(__file__).resolve().parents[1] / "site/migrations"
NUMBERED = re.compile(r"^(\d+)_(.+\.sql)$")


def load_twins(path: Path) -> list[list[str]]:
    return json.loads(path.read_text()) if path.exists() else []


def dump_twins(groups: list[list[str]]) -> str:
    """One group per line, so a port is a one-line diff."""
    rows = ",\n".join(f"  {json.dumps(g)}" for g in groups)
    return f"[\n{rows}\n]\n" if groups else "[]\n"


def next_name(dst: Path, stem: str) -> str:
    """`stem` under `dst`'s next number, at `dst`'s number width (default 4)."""
    nums = [m.group(1) for f in dst.glob("*.sql") if (m := NUMBERED.match(f.name))]
    width = max((len(n) for n in nums), default=4)
    return f"{max((int(n) for n in nums), default=0) + 1:0{width}d}_{stem}"


def port(migrations: Path, src: str, lineage: str) -> tuple[str, list[list[str]]]:
    """Copy `src` (`<lineage>/<NNNN_stem>.sql`) into `lineage`; return the
    new twin name and the updated groups (nothing is written)."""
    src_path = migrations / src
    if src_path.parent.parent != migrations or not src_path.is_file():
        raise ValueError(f"{src}: not a migration under {migrations} (`<lineage>/<NNNN_name>.sql`)")
    m = NUMBERED.match(src_path.name)
    if not m:
        raise ValueError(f"{src}: not a numbered migration (`NNNN_name.sql`)")
    stem = m.group(2)
    if src_path.parent.name == lineage:
        raise ValueError(f"{src}: already in lineage {lineage}")
    dst = migrations / lineage
    if not dst.is_dir():
        raise ValueError(f"{lineage}: no such lineage (no directory {dst})")
    taken = [f.name for f in dst.glob("*.sql") if (n := NUMBERED.match(f.name)) and n.group(2) == stem]
    if taken:
        raise ValueError(f"{lineage} already has a `{stem.removesuffix('.sql')}` migration: {', '.join(taken)}")
    groups = load_twins(migrations / "twins.json")
    group = next((g for g in groups if src in g), None)
    if group and any(t.split("/", 1)[0] == lineage for t in group):
        raise ValueError(f"{src} already has a twin in {lineage}: {group}")
    name = next_name(dst, stem)
    twin = f"{lineage}/{name}"
    if group is None:
        groups.append([src, twin])
    else:
        group.append(twin)
    return twin, groups


@command(help=__doc__)
@option('-m', '--migrations', 'migrations', type=Path, default=MIGRATIONS, show_default=True, help="The lineages' root dir.")
@option('-n', '--dry-run', is_flag=True, help='Print the new twin name; write nothing.')
@argument('src')
@argument('lineage')
def main(migrations: Path, dry_run: bool, src: str, lineage: str) -> None:
    migrations = migrations.resolve()
    try:
        twin, groups = port(migrations, src, lineage)
    except ValueError as e:
        err(f"port-migration: {e}")
        sys.exit(1)
    if not dry_run:
        (migrations / twin).write_bytes((migrations / src).read_bytes())
        (migrations / "twins.json").write_text(dump_twins(groups))
    print(twin)


if __name__ == "__main__":
    main()

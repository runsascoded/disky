#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click>=8,<9"]
# ///
"""Check canonical production or one named preview branch, with GET requests only."""
from collections.abc import Callable
from json import load
import os
from pathlib import Path
from subprocess import check_output
from tomllib import loads
from urllib.error import HTTPError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

from click import ClickException, command, option

SITE = Path(__file__).resolve().parent


def deploy_env(site: Path) -> dict[str, str]:
    file = site / "deploy.env"
    if not file.exists():
        return {}
    return dict(line.split("=", 1) for line in (line.strip() for line in file.read_text().splitlines()) if line and not line.startswith("#") and "=" in line)


def get_json(
    account: str,
    token: str,
    path: str,
) -> dict:
    request = Request(f"https://api.cloudflare.com/client/v4/accounts/{quote(account, safe='')}/pages/projects/{path}", headers={"Authorization": f"Bearer {token}"})
    try:
        with urlopen(request, timeout=20) as response:
            result = load(response)
    except HTTPError as error:
        raise ValueError(f"Cloudflare API HTTP {error.code}") from error
    if not result.get("success"):
        raise ValueError("Cloudflare API refused the read")
    return result


def deployment(
    fetch: Callable[[str], dict],
    project: str,
    branch: str | None,
) -> dict:
    """Use the canonical production record, or successful exact-branch preview with bounded paging."""
    project = quote(project, safe="")
    if branch is None:
        result = fetch(project)["result"].get("canonical_deployment")
        if not result or result.get("environment") != "production" or result.get("latest_stage", {}).get("status") != "success":
            raise ValueError("no successful canonical production deployment found")
        return result
    for page in range(1, 11):
        query = urlencode({"env": "preview", "per_page": 100, "page": page})
        result = fetch(f"{project}/deployments?{query}")
        for item in result["result"]:
            metadata = item.get("deployment_trigger", {}).get("metadata", {}) or {}
            if item.get("environment") == "preview" and metadata.get("branch") == branch and item.get("latest_stage", {}).get("status") == "success":
                return item
        pages = result.get("result_info", {}).get("total_pages")
        if not result["result"] or (pages is not None and page >= pages) or (pages is None and len(result["result"]) < 100):
            raise ValueError(f"no successful preview deployment for branch {branch}")
    raise ValueError(f"preview branch {branch} not found within 1000 deployments; inspect Pages directly")


def git(site: Path, *args: str) -> str:
    return check_output(["git", *args], cwd=site, text=True).strip()


def check(site: Path, dev: bool) -> int:
    config = site / "wrangler.toml"
    if not config.exists():
        raise ValueError("no site/wrangler.toml; run the deployment checkout's site/cf-status")
    project = loads(config.read_text()).get("name")
    if not isinstance(project, str) or not project:
        raise ValueError("wrangler.toml has no project name")
    settings = deploy_env(site)
    account = settings.get("CLOUDFLARE_ACCOUNT_ID") or os.environ.get("CLOUDFLARE_ACCOUNT_ID")
    token = os.environ.get("CLOUDFLARE_API_TOKEN")
    if not account or not token:
        raise ValueError("set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN (Pages read)")
    branch = (settings.get("DEV_BRANCH") or os.environ.get("DEV_BRANCH", "dev")) if dev else None
    item = deployment(lambda path: get_json(account, token, path), project, branch)
    metadata = item.get("deployment_trigger", {}).get("metadata", {}) or {}
    sha = metadata.get("commit_hash", "")
    head = git(site, "rev-parse", "HEAD")
    print(f"environment: preview ({branch})" if dev else "environment: production (canonical)")
    print(f"deployed: {sha[:9] or '(unknown)'}  ({item.get('created_on', '')})  [{item.get('short_id')}]")
    print(f"HEAD:     {head[:9]}")
    if metadata.get("commit_dirty"):
        print("? deployed from a dirty checkout; its commit does not identify the shipped tree")
        return 1
    if git(site, "status", "--porcelain", "--untracked-files=no"):
        print("? local tracked changes differ from HEAD; commit equality cannot verify this checkout")
        return 1
    if sha and sha == head:
        print("✓ HEAD is deployed")
        return 0
    if not sha:
        print("? deployed commit unknown (no commit_hash in deployment metadata)")
        return 1
    log = git(site, "log", "--oneline", f"{sha}..HEAD", "--", ".")
    print(f"✗ {len(log.splitlines()) if log else 0} undeployed commit(s) touching site/:")
    if log:
        print(log)
    return 1


@command()
@option("-d", "--dev", is_flag=True, help="Check the configured DEV_BRANCH instead of canonical production.")
def main(dev: bool) -> None:
    """Report this script's checkout against Cloudflare; GET requests only."""
    try:
        code = check(SITE, dev)
    except (ValueError, OSError) as error:
        raise ClickException(str(error)) from error
    raise SystemExit(code)


if __name__ == "__main__":
    main()

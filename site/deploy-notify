#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click==8.3.0", "thrds @ https://github.com/Open-Athena/thrds/archive/6f207846b32012d6a1550011f95bc561caf8ff1c.tar.gz"]
# ///
"""Review a deployment receipt; send only with an explicit flag. Notices are run-length threaded: greens with greens, reds with reds."""
from getpass import getuser
from collections.abc import Mapping
from json import dumps, loads
from os import environ
from pathlib import Path
from re import findall, fullmatch, search
from socket import setdefaulttimeout
from subprocess import check_output
from tomllib import loads as toml_loads
from urllib.parse import quote, urlsplit
from uuid import uuid4

from click import Choice, ClickException, Path as ClickPath, argument, group, option


RESULTS = ('success', 'failure', 'cancelled')
STAGES = ('build', 'upload', 'verify', 'finish')


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ClickException(message)


def https_url(value: str, field: str) -> str:
    parsed = urlsplit(value)
    require(parsed.scheme == 'https' and bool(parsed.hostname) and parsed.netloc == parsed.hostname
            and not parsed.query and not parsed.fragment and not any(c in value for c in '<>\n\r`'),
            f'{field}: expected an HTTPS URL without credentials, port, query or fragment')
    return value


def receipt(value: dict) -> dict:
    """Project an allowlist; controller receipts can contain private data that must never reach Slack."""
    require(value.get('notice_version') == 1, 'notice_version must be 1')
    deployment = value.get('deployment') or value.get('source_branch')
    require(isinstance(deployment, str) and fullmatch(r'[a-z0-9][a-z0-9-]{0,63}', deployment) is not None,
            'deployment must be a site slug')
    require(value.get('mode') in ('dev', 'prod'), 'mode must be dev or prod')
    require(value.get('status') in RESULTS, 'status must be success, failure or cancelled')
    require(value.get('stage') in STAGES, 'stage must be build, upload, verify or finish')
    sha = value.get('sha')
    require(sha is None or isinstance(sha, str) and fullmatch('[0-9a-f]{40}', sha) is not None,
            'sha must be a full 40-character revision or null')
    ref = value.get('source_branch')
    require(ref is None or isinstance(ref, str) and fullmatch(r'[A-Za-z0-9_./+-]+', ref) is not None,
            'source_branch must be a plain source ref or null')
    repo = value.get('repository')
    require(isinstance(repo, str) and fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repo) is not None,
            'repository must be owner/name')
    host = value.get('host')
    require(isinstance(host, str) and fullmatch(r'[a-z0-9][a-z0-9.-]*[a-z0-9]', host) is not None,
            'host must be a DNS name')
    verified = value.get('verified', False)
    require(type(verified) is bool and (not verified or value['status'] == 'success'),
            'verified must be a boolean and requires success')
    dirty = value.get('dirty')
    require(dirty is None or type(dirty) is bool, 'dirty must be a boolean or null')
    actor = value.get('actor')
    require(actor is None or isinstance(actor, str) and fullmatch(r'[A-Za-z0-9_.@+-]{1,128}', actor) is not None,
            'actor must be a plain user identifier or null')
    actor_source = value.get('actor_source')
    require(actor_source in (None, 'local', 'github'), 'actor_source must be local, github or null')
    attempt = value.get('attempt')
    require(isinstance(attempt, str) and fullmatch(r'[A-Za-z0-9_.:-]{1,128}', attempt) is not None,
            'attempt must be a plain attempt identifier')
    cf_id = value.get('cloudflare_deployment')
    require(cf_id is None or isinstance(cf_id, str) and fullmatch(r'[A-Za-z0-9-]{1,64}', cf_id) is not None,
            'cloudflare_deployment must be an ID or null')
    urls = {}
    for key in ('cloudflare_url', 'run_url'):
        url = value.get(key)
        require(url is None or isinstance(url, str), f'{key} must be a URL or null')
        urls[key] = https_url(url, key) if url else None
    return {
        'notice_version': 1, 'deployment': deployment, 'mode': value['mode'], 'status': value['status'],
        'stage': value['stage'], 'sha': sha, 'source_branch': ref, 'repository': repo, 'host': host,
        'verified': verified, 'dirty': dirty, 'actor': actor, 'actor_source': actor_source,
        'attempt': attempt, 'cloudflare_deployment': cf_id, **urls,
    }


def headline(value: dict) -> str:
    """The notice's sender name (`chat.postMessage` `username`): its outcome, so a notice is one line under it."""
    r = receipt(value)
    outcome = {'success': 'deployment succeeded', 'failure': f"deployment failed during {r['stage']}",
               'cancelled': 'deployment cancelled'}[r['status']]
    emoji = {'success': '✅', 'failure': '❌', 'cancelled': '⏹️'}[r['status']]
    return f"{emoji} {r['deployment'].upper()} {r['mode']} {outcome}"


def render(value: dict) -> str:
    """The notice's one line: source, warnings (a dirty or unrecorded tree, an unverified success), who, the CF
    deployment and links. A clean tree and a passed verification are the norm, so they say nothing."""
    r = receipt(value)
    repo = f"https://github.com/{r['repository']}"
    source = [f"[{r['source_branch']}]({repo}/tree/{quote(r['source_branch'], safe='/')})"] if r['source_branch'] else []
    if r['sha']:
        source.append(f"([{r['sha'][:9]}]({repo}/commit/{r['sha']}))")
    parts = [' '.join(source) or 'source not recorded']
    if r['dirty'] is None:
        parts.append('⚠️ tree state not recorded')
    elif r['dirty']:
        parts.append('⚠️ dirty')
    if r['status'] == 'success' and not r['verified']:
        parts.append('⚠️ unverified')
    if r['actor']:
        if r['actor_source'] == 'github' and not r['actor'].endswith('[bot]'):
            parts.append(f":gh: [{r['actor']}](https://github.com/{r['actor']})")
        else:
            parts.append(f"{':gh:' if r['actor_source'] == 'github' else ':computer:'} `{r['actor']}`")
    if r['cloudflare_deployment']:
        cf = r['cloudflare_deployment']
        parts.append(f":cf: [{cf}]({r['cloudflare_url']})" if r['cloudflare_url'] else f':cf: `{cf}`')
    parts.append(f"[site](https://{r['host']})")
    if r['run_url']:
        parts.append(f"[logs]({r['run_url']})")
    return ' · '.join(parts) + '\n'


# A notice's outcome as Slack stores it: its sender name (`headline`), or, before notices were one line (2026-11-14),
# the bold first line of its text.
SENDER = r'^\S+ ([A-Z0-9-]+) (?:dev|prod) deployment (succeeded|failed during [a-z]+|cancelled)$'
HEADLINE = r'\*([A-Z0-9-]+) (?:dev|prod) deployment (succeeded|failed during [a-z]+|cancelled)\*'
HISTORY = 100


def run_thread(
    history: list[dict],
    deployment: str,
    green: bool,
    bot: tuple[str, str | None],
) -> str | None:
    """The thread a notice joins: the newest top-level notice for this deployment, if it has the same color.

    Notices are run-length threaded by color (a failure and a cancellation are both red): the first notice after
    one of the other color, or with none in the last `HISTORY` channel messages, is a top-level post that opens a
    thread; each later notice of that color replies in it, until the color changes.
    """
    user_id, bot_id = bot
    for message in history:
        if message.get('user') != user_id and (bot_id is None or message.get('bot_id') != bot_id):
            continue
        match = search(SENDER, message.get('username') or '') or search(HEADLINE, message.get('text') or '')
        if match and match[1] == deployment.upper():
            return message['ts'] if (match[2] == 'succeeded') == green else None
    return None


def slack_client(
    token: str,
    channel: str,
):
    from thrds.slack import SlackClient

    return SlackClient(token, channel)


def send(value: dict, env: dict) -> str:
    """Post the notice, replying in the thread of the current run of its color. Returns the thread it joined, if any."""
    require(env.get('DEPLOY_NOTIFICATIONS_ENABLED') == '1', 'Deploy notifications are disabled pending template/transport review')
    token = env.get('SLACK_DEPLOY_BOT_TOKEN', '')
    require(fullmatch(r'xoxb-[A-Za-z0-9-]+', token) is not None, 'SLACK_DEPLOY_BOT_TOKEN must be a Slack bot token')
    channel = env.get('SLACK_DEPLOY_CHANNEL', '')
    require(fullmatch(r'[CG][A-Z0-9]{6,}', channel) is not None, 'SLACK_DEPLOY_CHANNEL must be a Slack channel ID')
    r = receipt(value)
    setdefaulttimeout(15)
    client = slack_client(token, channel)
    try:
        history = client.list_channel_history(channel, limit=HISTORY)
        thread = run_thread(history, r['deployment'], r['status'] == 'success', client.bot_ids)
    except (RuntimeError, OSError, KeyError):
        raise ClickException('Slack history lookup failed; nothing posted') from None
    try:
        client.post(render(r), thread, username=headline(r))
    except (RuntimeError, OSError):
        raise ClickException('Slack notification failed; acceptance unknown, not retried') from None
    return thread


def load(path: Path) -> dict:
    require(path.stat().st_size <= 262144, 'Receipt exceeds 256 KiB')
    value = loads(path.read_text())
    require(isinstance(value, dict), 'Receipt must be an object')
    return receipt(value)


def run_url(env: Mapping[str, str]) -> str | None:
    """The GitHub Actions run that recorded the notice (`GITHUB_SERVER_URL`/`GITHUB_REPOSITORY`/`GITHUB_RUN_ID`), else None."""
    server, repo, run = (env.get(k) for k in ('GITHUB_SERVER_URL', 'GITHUB_REPOSITORY', 'GITHUB_RUN_ID'))
    return f'{server}/{repo}/actions/runs/{run}' if server and repo and run else None


@group()
def main() -> None:
    """Record, review and explicitly send site deployment notices. Rendering never posts."""


@main.command('render')
@argument('path', type=ClickPath(exists=True, path_type=Path))
def render_cmd(path: Path) -> None:
    value = load(path)
    print(f'{headline(value)}\n{render(value)}', end='')


@main.command('send')
@option('-x', '--execute', is_flag=True, help='Send the reviewed template; also requires DEPLOY_NOTIFICATIONS_ENABLED=1')
@argument('path', type=ClickPath(exists=True, path_type=Path))
def send_cmd(execute: bool, path: Path) -> None:
    value = load(path)
    if execute:
        thread = send(value, dict(environ))
        print(f'Deployment notification posted{f" in thread {thread}" if thread else ""}.')
    else:
        print(f'{headline(value)}\n{render(value)}', end='')


@main.command('record')
@option('-c', '--config', 'config_path', type=ClickPath(exists=True, path_type=Path), required=True)
@option('-d', '--deployment', help='Site slug (default: configured STORE, else Pages project)')
@option('-e', '--mode', type=Choice(['dev', 'prod']), required=True)
@option('-g', '--sha', required=True)
@option('-l', '--upload-log', type=ClickPath(path_type=Path), required=True)
@option('-o', '--output', type=ClickPath(path_type=Path), required=True)
@option('-s', '--status', type=Choice(RESULTS), required=True)
@option('-t', '--stage', type=Choice(STAGES), required=True)
@option('-u', '--dirty', type=Choice(['true', 'false']), required=True)
@option('-v', '--verified', is_flag=True)
def record_cmd(
    config_path: Path,
    deployment: str | None,
    mode: str,
    sha: str,
    upload_log: Path,
    output: Path,
    status: str,
    stage: str,
    dirty: str,
    verified: bool,
) -> None:
    parsed = toml_loads(config_path.read_text())
    var = parsed.get('vars', {}) if mode == 'prod' else parsed.get('env', {}).get('preview', {}).get('vars', parsed.get('vars', {}))
    repo_url = https_url(var['REPO_URL'], 'REPO_URL')
    require(urlsplit(repo_url).hostname == 'github.com', 'REPO_URL must name GitHub')
    ref = environ.get('VITE_SOURCE_REF') or var.get('SOURCE_REF')
    if not ref:
        result = check_output(['git', 'rev-parse', '--abbrev-ref', 'HEAD'], cwd=config_path.resolve().parent, text=True).strip()
        ref = None if result == 'HEAD' else result
    urls = findall(r'Deployment complete![^\n]*(https://[a-z0-9]{8,32}\.[a-z0-9-]+\.pages\.dev)', upload_log.read_text()) if upload_log.exists() else []
    cf_url = next((url for url in reversed(urls) if urlsplit(url).hostname.endswith('.' + parsed['name'] + '.pages.dev')), None)
    actor = environ.get('GITHUB_ACTOR') or getuser()
    r = receipt({
        'notice_version': 1, 'deployment': deployment or var.get('STORE') or parsed['name'], 'mode': mode, 'status': status, 'stage': stage,
        'sha': sha, 'source_branch': ref, 'repository': urlsplit(repo_url).path.strip('/'),
        'host': var.get(f'{mode.upper()}_HOST', parsed['name'] + '.pages.dev'), 'verified': verified,
        'dirty': dirty == 'true', 'actor': actor, 'actor_source': 'github' if environ.get('GITHUB_ACTOR') else 'local',
        'attempt': str(uuid4()), 'cloudflare_deployment': urlsplit(cf_url).hostname.split('.')[0] if cf_url else None,
        'cloudflare_url': cf_url, 'run_url': run_url(environ),
    })
    output.write_text(dumps(r, indent=2) + '\n')


if __name__ == '__main__':
    main()
